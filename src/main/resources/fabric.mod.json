{
	"schemaVersion": 1,
	"id": "liquid_glass_ui",
	"version": "${version}",
	"name": "Liquid Glass UI",
	"description": "A faithful Fabric 1.21.1 backport of the ReGlass liquid-glass UI renderer.",
	"authors": [
		"ikunkk02-afk"
	],
	"contact": {
		"homepage": "https://github.com/ikunkk02-afk/Liquid-Glass-UI",
		"sources": "https://github.com/ikunkk02-afk/Liquid-Glass-UI",
		"issues": "https://github.com/ikunkk02-afk/Liquid-Glass-UI/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/liquid_glass_ui/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"restudio.reglass.ReGlass"
		],
		"client": [
			"restudio.reglass.client.ReGlassClient"
		]
	},
	"mixins": [
		{
			"config": "reglass.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
